# Regenerated by `node bin/scrape.js` on every run, ~36 MB and different every time —
# committing it would bloat the repo for data that has a shelf life of hours.
results.json

# Build outputs.
dist/
sync.sql
.catalogue/
.env
.env.*
!.env.example

node_modules/
.DS_Store
.wrangler/

# Local tooling config, not part of the project.
.claude/

# Database exports — contain visitor names and countries.
backups/

# AWS Lambda build artefacts. node_modules is installed at package time and the zip is
# rebuilt from it, so neither belongs in the repo — the repo itself stays dependency-free.
aws/lambda/node_modules/
aws/function.zip

# Secrets. Not ignored until now, which held only because nobody had run `git add -A`
# in a dirty tree — the file has been sitting there stageable since it was created.
.env
.env.*
!.env.example

# Local run artefacts: the catalogue cache and its screenshots, and the match traces
# the file-backed store writes in development. Both are regenerated on demand, and the
# traces carry résumé hashes and the queries people ran.
.catalogue/
.traces/
