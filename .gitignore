# Regenerated by `node scrape.js` on every run, ~36 MB and different every time —
# committing it would bloat the repo for data that has a shelf life of hours.
results.json

# Build outputs.
dist/
sync.sql

node_modules/
.DS_Store
.wrangler/

# Local tooling config, not part of the project.
.claude/

# Database exports — contain visitor names and countries.
backups/

# AWS Lambda build artefacts. node_modules is installed at package time and the zip is
# rebuilt from it, so neither belongs in the repo — the repo itself stays dependency-free.
aws/lambda/node_modules/
aws/function.zip
