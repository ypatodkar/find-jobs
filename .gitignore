# Regenerated by `node scrape.js` on every run, ~36 MB and different every time —
# committing it would bloat the repo for data that has a shelf life of hours.
results.json
# Written alongside it, same reasoning: job description text, sharded into dist/ by build.js.
descriptions.json

# Build outputs.
dist/
sync.sql
.catalogue/
.env
.env.*
!.env.example

node_modules/
.DS_Store
.wrangler/

# Local tooling config, not part of the project.
.claude/

# Database exports — contain visitor names and countries.
backups/

# AWS Lambda build artefacts. node_modules is installed at package time and the zip is
# rebuilt from it, so neither belongs in the repo — the repo itself stays dependency-free.
aws/lambda/node_modules/
aws/function.zip

# Local match traces written by the file-backed trace store during development.
.traces/

# Résumés used for scoring reviews (scripts/validate-matches.js) are personal.
validation/resumes/

# Jev classifications cached between scrapes (classify.js); CI keeps its own copy.
job-labels.json

# Original resume files saved by the dev server (aws/lambda/file-store.cjs); production keeps them in S3.
.resume-files/

# The React pages (web/): installed packages and build output.
web/node_modules/
web/dist/
