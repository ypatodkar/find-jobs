# Scraped data, regenerated on every run (scraper/scrape.js): results.json (~36 MB),
# descriptions.json and the Jev classification cache, job-labels.json, which CI keeps
# with actions/cache. Also the dev server's resume files (aws/lambda/file-store.cjs;
# production keeps them in S3).
data/

# Build outputs.
dist/
web/dist/

# Installed packages. The Lambda's are installed at package time and zipped from there.
node_modules/
web/node_modules/
aws/lambda/node_modules/
aws/function.zip

# Secrets.
.env
.env.*
!.env.example

# Screenshots the end-to-end test writes.
test/artifacts/

# Résumés used for scoring reviews (scripts/validate-matches.js) are personal.
validation/resumes/

# Database exports: they contain visitor names and countries.
backups/

# Local tooling.
.DS_Store
.claude/
